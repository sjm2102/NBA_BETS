# --- Safety: public repo should ONLY publish /docs ---
*
!.gitignore
!docs/
!docs/**

# Ignore common junk
.vscode/
.venv/
__pycache__/
*.pyc
*.xlsx
*.png
*.csv
*.json

# But allow the site data files inside /docs
!docs/*.csv
!docs/*.json
!docs/*.png
!docs/*.webmanifest
!docs/*.js
!docs/*.css
!docs/*.html

# Allow service worker / manifest
!docs/service-worker.js
!docs/manifest.webmanifest
